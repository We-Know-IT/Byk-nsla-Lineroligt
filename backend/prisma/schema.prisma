// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteThemeSelection {
  id             Int      @id @default(1)
  activeThemeKey String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteNavigationPage {
  key       String   @id
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteBackground {
  key                String                  @id
  label              String
  imageSrc           String
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  selections         SiteBackgroundSelection[]
}

model SiteBackgroundSelection {
  id                  Int             @id @default(1)
  activeBackgroundKey  String
  activeBackground     SiteBackground  @relation(fields: [activeBackgroundKey], references: [key], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}
